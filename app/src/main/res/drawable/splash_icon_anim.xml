<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="letter">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="650" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:valueFrom="0.3" android:valueTo="0.62" />
                <objectAnimator android:duration="650" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:valueFrom="0.3" android:valueTo="0.62" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="disc">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="900" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="rotation" android:valueFrom="-90" android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="spark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="900" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="rotation" android:valueFrom="0" android:valueTo="180" />
                <objectAnimator android:duration="450" android:propertyName="scaleX" android:repeatCount="1" android:repeatMode="reverse" android:valueFrom="0.6" android:valueTo="1.25" />
                <objectAnimator android:duration="450" android:propertyName="scaleY" android:repeatCount="1" android:repeatMode="reverse" android:valueFrom="0.6" android:valueTo="1.25" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
