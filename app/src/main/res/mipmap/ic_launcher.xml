<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x (no adaptive icons): the same artwork, cropped to the visible 72dp centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_legacy_bg" />
    <item
        android:bottom="-18dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-18dp"
        android:right="-18dp"
        android:top="-18dp" />
</layer-list>
